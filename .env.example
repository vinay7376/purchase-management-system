# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String
# Leave blank to use self-contained embedded in-memory MongoDB automatically!
# Or set to your persistent MongoDB instance (e.g. Docker, MongoDB Atlas, Railway)
MONGODB_URI=mongodb://localhost:27017/corvo_procure

# Optional Private Master Data Directory for Seeding
# Kept outside Git repository for data security
DATA_DIR=./Cantill_FullStack_Task_Kit
