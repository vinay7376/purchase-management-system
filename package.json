{
  "name": "corvo-procure-root",
  "version": "1.0.0",
  "private": true,
  "description": "Corvo Engineering Autonomous Policy-Driven Procurement System",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "build:all": "npm --prefix frontend run build",
